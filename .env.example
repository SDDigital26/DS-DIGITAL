# Шаблон окружения. Скопируйте в .env и заполните секреты (файл .env не коммитится).

# ─────────────────────────────────────────────────────────────
# Supabase (PostgreSQL)
# ─────────────────────────────────────────────────────────────
# Данные подключения, которые были выданы:
#   host=db.jgpzbbzaaklodpbyhpji.supabase.co
#   port=5432
#   database=postgres
#   user=postgres
# ВАЖНО: вставьте реальный пароль базы данных вместо ПАРОЛЬ.
# Параметр sslmode=require обязателен для Supabase.
# DATABASE_URL — для миграций/скриптов, запускаемых на хосте (npm run db:migrate).
# Рабочий адрес — IPv4-сессионный пулер (прямой db.<ref>.supabase.co отдаёт только IPv6).
# Пользователь пулера: postgres.<ref>, пароль — тот же, что и у базы.
DATABASE_URL="postgresql://postgres.jgpzbbzaaklodpbyhpji:ПАРОЛЬ@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require"

# DATABASE_URL_DOCKER — тот же адрес, но для контейнера web (в нём хост `localhost` — сам контейнер).
# Если не задан, контейнер использует локальный PostgreSQL из docker-compose.
# DATABASE_URL_DOCKER="postgresql://postgres.jgpzbbzaaklodpbyhpji:ПАРОЛЬ@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Публичный URL сайта (без завершающего слеша)
NEXT_PUBLIC_SITE_URL="http://localhost:3013"

# ─────────────────────────────────────────────────────────────
# Рекламные счётчики (необязательно). Грузятся ТОЛЬКО после согласия
# на аналитику (cookie-баннер) и только если ID задан.
# События: lead_submit, calc_used, contact_click (ТЗ §16).
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_YM_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_VK_PIXEL_ID=""

# ─────────────────────────────────────────────────────────────
# Уведомления о заявках (необязательно)
# ─────────────────────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
LEADS_NOTIFY_EMAIL=""
EMAIL_API_ENDPOINT=""
EMAIL_API_KEY=""
