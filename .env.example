# Скопируйте в .env и заполните. Секреты НЕ коммитятся (ТЗ §21.5).

# Публичный адрес сайта (для canonical/hreflang/sitemap)
# В Docker-окружении сайт слушает порт 3001 (3000 занят другим dev-сервером).
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# PostgreSQL — этап 3 плана (backend/БД)
DATABASE_URL=postgresql://ds:ds_pass@localhost:5432/ds_digital

# Секрет служебных роутов (revalidate/notify) — сгенерируйте длинное случайное значение
# NEXTJS_SECRET=

# AI-провайдер (этап 8; ключ ТОЛЬКО на сервере, никогда в NEXT_PUBLIC_*) [С]
# AI_API_KEY=
# AI_MODEL=

# Email-уведомления (этап 3) [С]
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# LEADS_NOTIFY_EMAIL=

# Telegram-бот для уведомлений (этап 3) [С]
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
