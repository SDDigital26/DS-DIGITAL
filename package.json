{
  "name": "ds-digital",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:validate": "prisma validate",
    "seed:owner": "tsx scripts/seed-owner.ts",
    "seed:content": "tsx scripts/seed-content.ts",
    "seed:calculator": "tsx scripts/seed-calculator.ts",
    "seed:articles": "tsx scripts/seed-articles.ts && tsx scripts/seed-articles-more.ts && tsx scripts/seed-articles-final.ts",
    "seed:knowledge": "tsx scripts/seed-knowledge.ts",
    "seed:demo": "tsx scripts/seed-demo-data.ts",
    "settings:apply-provided": "tsx scripts/apply-provided-settings.ts",
    "pages:build": "node scripts/build-gh-pages.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "next": "16.4.6",
    "nodemailer": "^10.6.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "^7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}
